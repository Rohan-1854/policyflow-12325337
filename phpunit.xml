<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Throwaway key for the test run only; not used anywhere else. -->
        <env name="APP_KEY" value="base64:dGVzdC1vbmx5LWtleS1ub3QtYS1zZWNyZXQtMDAwMDA="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Tests default to in-memory SQLite so the reviewer needs no DB server.
             To run them against MySQL/PostgreSQL see README "Running tests on MySQL". -->
        <env name="DB_CONNECTION" value="sqlite" force="false"/>
        <env name="DB_DATABASE" value=":memory:" force="false"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="INSURER_DRIVER" value="local"/>
        <env name="MOCK_INSURER_ENABLED" value="true"/>
        <env name="MOCK_INSURER_DEFAULT_SCENARIO" value="SUCCESS"/>
        <env name="MOCK_INSURER_TEMPORARY_FAILURES" value="1"/>
        <env name="MOCK_INSURER_DUPLICATE_DELIVERIES" value="3"/>
        <env name="MOCK_INSURER_WEBHOOK_SECRET" value="test-webhook-secret"/>
        <env name="MOCK_INSURER_VERIFY_SIGNATURE" value="true"/>
        <env name="ISSUANCE_MAX_ATTEMPTS" value="3"/>
    </php>
</phpunit>
