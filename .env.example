# PolicyFlow - example configuration. Placeholders only, no real credentials.
# Copy to .env and run `php artisan key:generate`.

APP_NAME=PolicyFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL 8+ (default). For PostgreSQL use DB_CONNECTION=pgsql and DB_PORT=5432.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=policyflow
DB_USERNAME=root
DB_PASSWORD=

# The API is stateless; no session/cache tables are needed.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ---------------------------------------------------------------------------
# Insurer integration
# ---------------------------------------------------------------------------
# local = in-process simulated insurer (default, works with `php artisan serve`)
# http  = call the mock insurer HTTP endpoints at INSURER_HTTP_BASE_URL
#         (needs a server that can handle concurrent requests, see README)
INSURER_DRIVER=local
INSURER_HTTP_BASE_URL=http://127.0.0.1:8000/api/mock-insurer
INSURER_HTTP_TIMEOUT_SECONDS=5

# Total issue attempts allowed per policy request (first try + retries).
ISSUANCE_MAX_ATTEMPTS=3
# A request stuck in SUBMITTED longer than this is treated as an unknown
# outcome and reconciled instead of re-issued.
ISSUANCE_SUBMISSION_LEASE_SECONDS=120
# PENDING_CONFIRMATION older than this is picked up by policyflow:reconcile.
ISSUANCE_PENDING_STALE_MINUTES=15

# ---------------------------------------------------------------------------
# Mock insurer (development only; disabled automatically in production)
# ---------------------------------------------------------------------------
MOCK_INSURER_ENABLED=true
# SUCCESS | TEMPORARY_FAILURE | TIMEOUT_AFTER_ISSUE | TIMEOUT_BEFORE_ISSUE |
# DELAYED_CALLBACK | DUPLICATE_CALLBACK | PERMANENT_FAILURE
MOCK_INSURER_DEFAULT_SCENARIO=SUCCESS
# TEMPORARY_FAILURE fails this many issue calls before succeeding.
MOCK_INSURER_TEMPORARY_FAILURES=1
# DUPLICATE_CALLBACK delivers the identical event this many times.
MOCK_INSURER_DUPLICATE_DELIVERIES=3

# Shared secret used to HMAC-sign provider callbacks. Replace locally.
MOCK_INSURER_WEBHOOK_SECRET=replace-with-a-long-random-local-secret
MOCK_INSURER_VERIFY_SIGNATURE=true
